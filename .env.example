# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string (use the "session pooler" one), with your password filled in.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Which data the API serves: duckdb (local, scores live with the model) or postgres (the deployed demo).
DATA_BACKEND=duckdb

# Websites allowed to call the API from a browser, comma-separated. The web app runs on port 3000 locally.
ALLOWED_ORIGINS=http://localhost:3000
